# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentor_platform
DB_USER=user
DB_PASSWORD=
DB_SSL=false

# JWT Configuration
JWT_SECRET=test-secret-key-minimum-32-characters-long-for-testing-purposes-only-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (Resend) - Optional for development
RESEND_API_KEY=
RESEND_FROM=noreply@mentorplatform.com

# Payment Configuration (Cashfree) - Optional for development
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# AWS S3 Configuration - Optional for development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=mentor-platform-media

# AI Services Configuration - Optional for development
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Admin Configuration
ADMIN_EMAIL=admin@mentorplatform.com
